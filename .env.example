# Supabase — required for auth, database and RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL — used to build links in emails (invite redirect, etc).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — required for billing. An account only activates once the
# checkout.session.completed webhook fires, so both the secret key and the
# webhook secret are required for signup to work end-to-end. Three
# self-serve tiers only — the >5-practice "enterprise" tier has no Stripe
# price at all; those accounts are provisioned by hand after a
# callback_requests lead closes (see /request-callback).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SOLO_ANNUAL=
STRIPE_PRICE_PRACTICE_MONTHLY=
STRIPE_PRICE_PRACTICE_ANNUAL=
STRIPE_PRICE_MULTISITE_MONTHLY=
STRIPE_PRICE_MULTISITE_ANNUAL=

# Twilio — SMS follow-up sequence. Leave unset to see the "not connected
# yet" state in Settings; the cron job will mark sends as failed instead of
# crashing.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: the exact public URL set as Twilio's "A message comes in"
# webhook, if it differs from NEXT_PUBLIC_SITE_URL + /api/webhooks/twilio/inbound.
# Twilio signs this URL, and unsigned/mis-signed requests are rejected.
TWILIO_WEBHOOK_URL=

# WhatsApp Business API integration point (via Twilio's WhatsApp channel).
# Requires an approved WhatsApp sender number from Twilio, e.g.
# "whatsapp:+441234567890". Leave unset until you connect a real account —
# see lib/messaging/whatsapp.ts.
TWILIO_WHATSAPP_FROM=

# Email follow-up channel (Resend's HTTP API — no SDK dependency).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when it triggers /api/cron/*. Generate any random string.
CRON_SECRET=
